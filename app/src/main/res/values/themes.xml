<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nivyx" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nivyx_paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Nivyx.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nivyx_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Nivyx</item>
    </style>
</resources>
